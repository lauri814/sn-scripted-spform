<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide">
    <g:evaluate var="jvar_task_id">
        var taskId = String(RP.getParameterValue('sysparm_task_id') || '');
        /^[a-f0-9]{32}$/.test(taskId) ? taskId : '';
    </g:evaluate>
    <g:evaluate var="jvar_task_table" jelly="true">
        var taskTable = '';
        var taskRecord = new GlideRecordSecure('task');
        if (jelly.jvar_task_id &amp;&amp; taskRecord.get(jelly.jvar_task_id) &amp;&amp; taskRecord.canRead())
            taskTable = String(taskRecord.getRecordClassName());
        encodeURIComponent(taskTable);
    </g:evaluate>
    <g:evaluate var="jvar_source_encoded" jelly="true">
        var payload;
        try {
            payload = new TaskInputSource().read(jelly.jvar_task_id);
        } catch (error) {
            payload = {error: String(error.message || error)};
        }
        encodeURIComponent(JSON.stringify(payload));
    </g:evaluate>
    <input id="source-data" type="hidden" value="${jvar_source_encoded}" />
    <div class="container-fluid" id="request-input-builder">
        <h2>Request additional input</h2>
        <p id="source-summary"></p>
        <p class="text-muted">Choose questions for a separate input form. Source task variables will not be updated.</p>
        <div class="form-group">
            <label for="input-form-title">Form title</label>
            <input id="input-form-title" class="form-control" value="Additional information needed" />
        </div>
        <p id="builder-status" role="status" aria-live="polite"></p>
        <div class="row">
            <div class="col-sm-5">
                <h3>Available questions</h3>
                <div id="available-variables"></div>
                <button id="preview-form" type="button" class="btn btn-primary" disabled="disabled">Preview form</button>
                <details>
                    <summary>Advanced: generated JSON</summary>
                    <pre id="generated-definition" tabindex="0" aria-label="Generated form JSON"></pre>
                </details>
            </div>
            <div class="col-sm-7">
                <h3>End-user preview</h3>
                <iframe id="form-preview" title="End-user form preview" style="width:100%; min-height:600px; border:0" src="/esc?id=newpage&amp;table=${jvar_task_table}&amp;sys_id=${jvar_task_id}&amp;sysparm_scripted_preview=true"></iframe>
            </div>
        </div>
    </div>
</j:jelly>
